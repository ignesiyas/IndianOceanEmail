PORT=3000

# SMTP (Hostinger example)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-email-password-or-app-password

# Sender shown in inbox
MAIL_FROM="Your App Name <your-email@yourdomain.com>"

# API security: send this token in Authorization header
# Example: Authorization: Bearer your-very-secret-token
API_BEARER_TOKEN=change-this-to-a-long-random-token

# Rate limiting for POST /send-email
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20

# Set true if running behind reverse proxy/load balancer (common on hosting panels)
TRUST_PROXY=true

# Optional: comma-separated list for browser requests
# Example: https://app.example.com,https://admin.example.com
CORS_ORIGIN=*
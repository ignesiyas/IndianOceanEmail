PORT=3000

# SMTP (Hostinger example)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-email-password-or-app-password

# Sender shown in inbox
MAIL_FROM="Your App Name <your-email@yourdomain.com>"

# API security: send this token in Authorization header
# Example: Authorization: Bearer your-very-secret-token
API_BEARER_TOKEN=123456789abcdef

# Optional: comma-separated list for browser requests
# Example: https://app.example.com,https://admin.example.com
CORS_ORIGIN=*